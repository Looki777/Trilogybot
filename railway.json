    {
      "$schema": "https://docs.railway.app/schemas/railway.schema.json",
      "build": {
        "builder": "NIXPACKS" 
        // Или "builder": "HEROKU_BUILD_PACKS" если NIXPACKS не работает.
        // Если вы не уверены, начните с NIXPACKS, так как он упоминается в логах.
      },
      "deploy": {
        "startCommand": "python bot.py",
        "environment": {
          "TELEGRAM_BOT_TOKEN": "${TELEGRAM_BOT_TOKEN}",
          "DB_PATH": "${DB_PATH}"
        }
      }
    }
    